// ============ PRD v2.0 新增表 ============

// I-03 数据库会话兜底表：即使 Redis 丢失，登录拦截器也能查此表拒绝过期 Token
model usersession {
  id                String   @id @default(cuid())
  userId            String
  deviceId          String
  sessionToken      String   @unique @map("session_token")
  refreshTokenHash  String   @map("refresh_token_hash")
  absoluteExpireAt  DateTime @map("absolute_expire_at")
  idleExpireAt      DateTime @map("idle_expire_at")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserSession_userId_fkey")

  @@index([userId], map: "UserSession_userId_idx")
  @@index([sessionToken], map: "UserSession_sessionToken_idx")
  @@index([absoluteExpireAt], map: "UserSession_absoluteExpireAt_idx")
  @@map("user_session")
}

// E-03 网关黑名单（IP/User）数据库兜底：PRD 原意用 Redis，本仓库以 MySQL 等价实现
model gatewayblacklist {
  id        String   @id @default(cuid())
  type      String // "ip" | "user"
  target    String // IP 地址 或 userId
  reason    String?
  expireAt  DateTime @map("expire_at")
  createdAt DateTime @default(now())

  @@index([type, target], map: "GatewayBlacklist_type_target_idx")
  @@index([expireAt], map: "GatewayBlacklist_expireAt_idx")
  @@map("gateway_blacklist")
}

// E-04 Step-up 二次鉴权临时令牌：PRD 原意存 Redis(3min)，本仓库以 MySQL 等价实现
model stepuptoken {
  id        String   @id @default(cuid())
  userId    String
  operation String
  code      String
  expireAt  DateTime @map("expire_at")
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "StepUpToken_userId_fkey")

  @@index([userId, operation], map: "StepUpToken_userId_operation_idx")
  @@index([expireAt], map: "StepUpToken_expireAt_idx")
  @@map("stepup_token")
}

// G-02 系统维护模式持久化（替代进程内存变量，确保多实例一致）
model systemconfig {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
  @@map("system_config")
}

// ============ 组件目录（唯一数据源，禁止前端/后端代码写死组件信息） ============

// 组件目录表：系统全部组件的元数据（名称/描述/分类/图标/标签/计费/预览/输入方式）。
// 前端与后端一律通过 /api/studio?action=catalog 从本表读取，代码中不得再硬编码组件列表。
model componentcatalog {
  id              String    @id // C01-C53
  name            String
  description     String
  category        String // 分类 key（BID_PREP / REQ_DESIGN / ...）
  icon            String
  tags            Json // string[]
  isPremium       Boolean   @default(false)
  estimatedTokens Int       @default(0)
  previewData     Json // { inputMock, outputMock, roiText }
  businessTags    Json? // string[]
  inputMode       String    @default("text") // text | file | both
  accept          String? // 文件上传支持的格式
  hint            String? // 界面引导文案
  detail          Json? // 深度详情：{ fullDescription, usage, apiDoc, faq }
  isDefault       Boolean   @default(false) // 是否为新空间默认装配的 5 套件组件
  contract        String? // 数据流动契约描述，如 "PDF ➜ 偏离表"
  keywords        Json? // 智能搜索关键词 string[]，用于需求检索匹配组件
  sortOrder       Int       @default(0)
  isPublished     Boolean   @default(true)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category], map: "ComponentCatalog_category_idx")
  @@index([isPublished], map: "ComponentCatalog_isPublished_idx")
  @@index([sortOrder], map: "ComponentCatalog_sortOrder_idx")
  @@map("component_catalog")
}

// 组件分类表：阶段分类的显示名/主题色/组件范围。
model componentcategory {
  key       String   @id // BID_PREP / REQ_DESIGN / ...
  name      String
  color     String
  range     String // 如 "C01-C06"
  sortOrder Int      @default(0)

  @@map("component_category")
}

// 岗位表：预置岗位 + 空间所有者自定义岗位统一定义（名称/徽标/默认组件授权矩阵）。
// 预置岗位由 seed 一次性写入（isPreset=true），运行期由 /api/studio?action=positions 与配置中心读写。
model position {
  id                         String   @id // 如 pos_owner / pos_custom_xxx
  code                       String   @unique // 如 OWNER / PROJECT_MANAGER / 自定义唯一码
  name                       String
  badge                      String?
  icon                       String?
  colorCls                   String? // Tailwind 徽章样式类
  description                String?
  isPreset                   Boolean  @default(true) // 预置岗位不可删除，仅可覆盖授权
  editable                   Boolean  @default(true) // 是否允许空间所有者编辑
  status                     String   @default("ACTIVE") // ACTIVE | DISABLED
  defaultAllowedComponentIds Json? // string[] 默认允许组件 ID，null 表示不限制
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([status], map: "Position_status_idx")
  @@index([sortOrder], map: "Position_sortOrder_idx")
  @@map("position")
}

// Webhook 事件订阅实体表：支持 Webhooks 真实订阅与事件推发日志
model webhooksubscription {
  id             String    @id @default(uuid())
  userId         String
  url            String
  secret         String
  events         Json      // string[] 存订阅事件
  active         Boolean   @default(true)
  successRate    String    @default("100%")
  lastTriggered  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId], map: "Webhook_userId_idx")
  @@index([active], map: "Webhook_active_idx")
  @@map("webhooksubscription")
}

// 账单与交易记录表：记录空间套餐升级、会员订阅、算力充值等真实交易流水，
// 供计费中心查询、对账与发票导出使用（对应前端 /settings/billing 页面）。
model billingrecord {
  id          String   @id
  userId      String
  workspaceId String?
  // 交易类型：PLAN_UPGRADE 空间套餐升级 / MEMBERSHIP 会员订阅 / TOKEN_RECHARGE 算力充值 / REFUND 退款
  type        String
  title       String // 交易描述说明
  // 交易金额，单位：分（与 membershiplevel 价格口径保持一致）
  amount      Int      @default(0)
  currency    String   @default("CNY")
  // 交易状态：SUCCESS 成功 / PENDING 处理中 / FAILED 失败 / REFUNDED 已退款
  status      String   @default("SUCCESS")
  channel     String? // 支付渠道
  referenceId String? // 关联业务单号（如操作日志 ID）
  invoiceUrl  String?
  metadata    Json? // 扩展信息（如套餐升级前后对比）

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId], map: "BillingRecord_userId_idx")
  @@index([workspaceId], map: "BillingRecord_workspaceId_idx")
  @@index([status], map: "BillingRecord_status_idx")
  @@index([createdAt], map: "BillingRecord_createdAt_idx")
  @@map("billing_record")
}

model tokenpack {
  id          String   @id
  name        String
  points      BigInt
  price       Float
  icon        String?  @default("⚡")
  color       String?  @default("#3182ce")
  description String?
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive], map: "TokenPack_isActive_idx")
  @@index([sortOrder], map: "TokenPack_sortOrder_idx")
}

// ============================================================
// 资料治理模块：移除单 / 资料级权限 / 版本 / 评论 / 分享
// 说明：以下表仅以 String 保存关联 ID，不建立 Prisma 关系，
// 避免改动既有 model，且移除记录需长期留存、不随资料级联删除。
// ============================================================

// 资料移除单：管理员移除资料的原因与执行记录，支持恢复
model documentremoval {
  id            String    @id
  documentId    String
  workspaceId   String
  titleSnapshot String
  uploaderId    String?
  removedBy     String
  reasonCode    String // VIOLATION 违规 | EXPIRED 过期 | COPYRIGHT 版权 | OTHER 其他
  reasonDetail  String?   @db.Text
  // 删除申请状态：PENDING 待管理员审核（普通成员删除自己资料）| APPROVED 已生效移除 | REJECTED 已驳回
  status        String   @default("APPROVED")
  // 管理员驳回删除申请时填写的意见，回写给申请人
  rejectReason  String?   @db.Text
  notifiedCount Int       @default(0)
  removedAt     DateTime  @default(now())
  restoredAt    DateTime?
  restoredBy    String?
  // 上传人确认接收移除：确认后资料转入个人私密，可在治理中心申请恢复
  confirmedAt   DateTime?
  confirmedBy   String?
  // 上传人申请恢复：记录申请时间与说明，避免重复申请并更新遮罩层状态
  restoreRequestedAt    DateTime?
  restoreRequestMessage String?   @db.Text

  @@index([workspaceId, removedAt], map: "DocumentRemoval_workspaceId_removedAt_idx")
  @@index([documentId], map: "DocumentRemoval_documentId_idx")
  @@index([workspaceId, status], map: "DocumentRemoval_workspaceId_status_idx")
  @@index([workspaceId, confirmedAt], map: "DocumentRemoval_workspaceId_confirmedAt_idx")
}

// 资料级操作权限：可精确授予某成员，或按角色 / 岗位批量授予
model assetpermission {
  id               String   @id
  workspaceId      String
  userId           String?
  roleScope        String?
  positionCode     String?
  canView          Boolean  @default(true)
  canUpload        Boolean  @default(false)
  canEdit          Boolean  @default(false)
  canDelete        Boolean  @default(false)
  canShare         Boolean  @default(false)
  canComment       Boolean  @default(true)
  canManageVersion Boolean  @default(false)
  grantedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId], map: "AssetPermission_workspaceId_idx")
  @@index([workspaceId, userId], map: "AssetPermission_workspaceId_userId_idx")
}

// 资料版本快照：编辑前自动留存，支持对比与回滚
model documentversion {
  id         String   @id
  documentId String
  versionNo  Int
  title      String
  content    String   @db.Text
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@unique([documentId, versionNo], map: "DocumentVersion_documentId_versionNo_key")
  @@index([documentId, createdAt], map: "DocumentVersion_documentId_createdAt_idx")
}

// 空间级套餐配置表：供空间创建初始化与空间套餐升级使用，后台可配置
model workspaceplan {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String
  priceMonthly  Int      @default(0)
  priceYearly   Int      @default(0)
  maxComponents Int      @default(0)
  maxMembers    Int      @default(0)
  maxStorage    Int      @default(0)
  maxApiCalls   Int      @default(0)
  tokenLimit    Int      @default(0)
  features      Json?
  sortOrder     Int      @default(0)
  purchasable   Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder], map: "WorkspacePlan_sortOrder_idx")
  @@index([isActive], map: "WorkspacePlan_isActive_idx")
}

// 资料评论：支持楼中楼回复
model documentcomment {
  id          String   @id
  documentId  String
  workspaceId String
  userId      String
  userName    String?
  content     String   @db.Text
  parentId    String?
  createdAt   DateTime @default(now())

  @@index([documentId, createdAt], map: "DocumentComment_documentId_createdAt_idx")
  @@index([workspaceId], map: "DocumentComment_workspaceId_idx")
}

// 资料分享链接：token 访问，支持过期与吊销
model documentshare {
  id          String    @id
  documentId  String
  workspaceId String
  token       String    @unique
  permission  String    @default("view") // view | download
  expiresAt   DateTime?
  accessCount Int       @default(0)
  revokedAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([documentId], map: "DocumentShare_documentId_idx")
  @@index([workspaceId], map: "DocumentShare_workspaceId_idx")
}
