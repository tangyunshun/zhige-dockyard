  key         String   @unique(map: "SystemSetting_key_key")
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

model tokenpack {
  id          String   @id
  name        String
  points      BigInt
  price       Float
  icon        String?  @default("⚡")
  color       String?  @default("#3182ce")
  description String?
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive], map: "TokenPack_isActive_idx")
  @@index([sortOrder], map: "TokenPack_sortOrder_idx")
}

/// 用户算力钱包：跨空间通用的算力点余额（快照，真源为 pointgrant 分桶剩余量之和）
/// 说明：钱包中的算力点可在个人空间与企业空间中通用消费。
model userwallet {
  id        String   @id
  userId    String   @unique(map: "UserWallet_userId_key")
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], map: "UserWallet_userId_idx")
}

/// 算力分桶（发放批次）：每一笔发放（赠送 / 在线充值 / 线下工单入账 / 退款 / 后台调整）
/// 生成一个独立分桶，记录发放量、剩余量与到期时间。
/// 消耗时按「最早到期优先」逐桶扣减；到期未用完的桶由到期清算任务清零。
model pointgrant {
  id          String    @id
  /// 归属范围：WALLET 用户钱包（跨空间通用）| WORKSPACE 空间共享池 | PERSONAL_GIFT 个人空间专属赠送
  scope       String
  userId      String?
  workspaceId String?
  /// 本桶发放总量
  points      BigInt
  /// 本桶剩余可用量
  remaining   BigInt
  /// 来源类型：GIFT_REGISTER / RECHARGE / OFFLINE_ORDER / MEMBERSHIP / REFUND / MANUAL
  sourceType  String
  /// 关联单号（充值订单号 / 工单号 / 流水号）
  sourceId    String?
  /// 到期时间，null 表示永不过期（赠送点默认 3 个月有效）
  expiresAt   DateTime?
  /// ACTIVE 可用 | EXPIRED 已到期清零 | EXHAUSTED 已用完
  status      String    @default("ACTIVE")
  /// 发放人（后台人工入账/审批人）
  operatorId  String?
  title       String?
  remark      String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status], map: "PointGrant_userId_status_idx")
  @@index([workspaceId, status], map: "PointGrant_workspaceId_status_idx")
  @@index([status, expiresAt], map: "PointGrant_status_expiresAt_idx")
}

/// 算力点流水总账：所有入账与出账的唯一权威记录，用于明细呈现、统计与对账
model pointledger {
  id            String   @id
  /// 方向：IN 入账 | OUT 出账
  direction     String
  /// 类型：GIFT_REGISTER 新用户赠送 | GIFT_EXPIRE 赠送到期清零 | RECHARGE 在线充值
  ///      OFFLINE_RECHARGE 线下工单入账 | MEMBERSHIP_GRANT 会员额度 | CONSUME 组件消耗
  ///      REFUND 退回 | MANUAL_ADJUST 后台人工调整
  type          String
  /// 归属范围：WALLET | WORKSPACE | PERSONAL_GIFT 个人空间赠送 | PERSONAL_DEDUCTION 个人空间扣减
  scope         String
  userId        String?
  userEmail     String?
  workspaceId   String?
  workspaceName String?
  /// 空间类型：PERSONAL | ENTERPRISE（便于个人/企业消耗分账统计）
  workspaceType String?
  /// 操作人（消费者 / 后台操作人 / 审批人）
  operatorId    String?
  /// 变动点数（正数，增减由 direction 决定）
  points        BigInt
  /// 变动后该账户余额快照（用于对账）
  balanceAfter  BigInt   @default(0)
  /// 实付金额（单位：分），赠送/消耗为 0
  amountCents   Int      @default(0)
  /// 支付方式：WECHAT_PAY | ALIPAY | OFFLINE_BANK | CONTRACT | SYSTEM | MANUAL
  paymentMethod String?
  /// 关联订单号 / 工单号
  orderNo       String?
  /// 关联分桶 ID
  grantId       String?
  componentId   String?
  componentName String?
  taskId        String?
  title         String
  remark        String?  @db.Text
  /// 幂等键（赠送、扣费、入账均需携带，防止重复记账）
  idempotencyKey String? @unique(map: "PointLedger_idempotencyKey_key")
  createdAt     DateTime @default(now())

  @@index([userId, createdAt], map: "PointLedger_userId_createdAt_idx")
  @@index([workspaceId, createdAt], map: "PointLedger_workspaceId_createdAt_idx")
  @@index([type], map: "PointLedger_type_idx")
  @@index([direction], map: "PointLedger_direction_idx")
  @@index([createdAt], map: "PointLedger_createdAt_idx")
}

/// 模型失败退款恢复记录：记录待退款的完整消费事实，支持管理员查询与幂等重试
/// 仅记录账务与任务标识，不记录原始材料 / Prompt / API Key
model refundrecovery {
  id                    String   @id
  taskId                String
  userId                String
  workspaceId           String
  /// 消费幂等键（CONSUME:{taskId}），重试时用于再次重建消费结果
  consumeIdempotencyKey String
  /// 消费流水 ID 列表（JSON 数组），用于审计与对账
  consumeLedgerIds      Json
  /// 消费明细（各来源分桶），用于重建 ConsumeResult 执行原路退款
  details               Json
  /// 本次应退款点数
  points                BigInt   @default(0)
  /// 需要回滚的月度用量增量
  monthlyUsedRollback   BigInt   @default(0)
  /// PENDING | PROCESSING | SETTLED | FAILED | REQUIRES_REVIEW
  status                String   @default("PENDING")
  retryCount            Int      @default(0)
  lastError             String?  @db.Text
  processingStartedAt   DateTime?
  leaseUntil            DateTime?
  /// 租约 fencing token：每次认领生成并校验，阻止旧 Worker 覆盖新 Worker 状态
  claimToken            String?   @unique(map: "RefundRecovery_claimToken_key")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([taskId, consumeIdempotencyKey], map: "RefundRecovery_taskId_key_key")
  @@index([status], map: "RefundRecovery_status_idx")
  @@index([userId], map: "RefundRecovery_userId_idx")
}

/// 用户自助退款申请：用户对「已扣费且成功」的任务申请退还算力点，必须经管理员审批后才真正退点。
/// 本表仅记录申请事实与审批结论；真实退点一律由账务层生成 REFUND 流水，
/// 杜绝出现「页面显示已退款但无任何账款流水」的虚假状态（refundLedgerId 为唯一可追溯凭证）。
model refundrequest {
  id           String   @id
  taskId       String
  userId       String
  workspaceId  String?
  componentId  String?
  /// 申请退还的点数（取该任务实际扣除点数）
  points       Int      @default(0)
  /// 用户填写的申请原因
  reason       String   @db.Text
  /// PENDING（待审批）| APPROVED（已同意并已退点）| REJECTED（已驳回）
  status       String   @default("PENDING")
  /// 审批人 userId（管理员 / 超级管理员）
  adminId      String?
  /// 审批意见（驳回时必填）
  adminRemark  String?  @db.Text
  /// 退点成功后生成的账款流水 ID；为空表示尚未产生真实退款流水
  refundLedgerId String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  /// 同一用户对同一任务只能有一条申请，幂等防重复
  @@unique([taskId, userId], map: "RefundRequest_taskId_userId_key")
  @@index([status, createdAt], map: "RefundRequest_status_createdAt_idx")
  @@index([userId, createdAt], map: "RefundRequest_userId_createdAt_idx")
}
/// 模型供应商（服务端直连配置；API Key 不入库，仅保存环境变量名）
model modelprovider {
  id          String   @id
  /// 供应商名称（平台**稳定标识**，也是合同与 modeldeployment 中的 providerId）：创建后禁止修改
  name        String   @unique(map: "ModelProvider_name_key")
  /// 对接协议：本期仅 OPENAI_COMPATIBLE
  protocol    String   @default("OPENAI_COMPATIBLE")
  /// 服务端直连地址（不向前端下发完整密钥信息）
  baseUrl     String
  /// API Key 所在环境变量名（禁止把密钥明文写入数据库）
  apiKeyEnv   String   @default("MODEL_API_KEY")
  /// API Key 密文（AES-256-GCM，base64）：后台直接录入密钥时落库；为空时回退到 apiKeyEnv 对应环境变量
  apiKeyCipher String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 该供应商下的模型部署（外键引用 name：providerId 的语义即供应商平台标识 name）
  deployments modeldeployment[]

  @@index([enabled], map: "ModelProvider_enabled_idx")
}

/// 具体模型部署（含上下文限制与价格配置）
model modeldeployment {
  id            String   @id
  /// 供应商平台标识 = modelprovider.name（数据库外键固化该语义），合同中的 providerId 同义
  providerId    String
  /// 平台内模型标识（合同中的 modelId）
  modelId       String
  /// 供应商侧真实模型名（调用时实际下发）
  upstreamModel String
  displayName   String   @default("")
  /// 上下文上限（tokens）
  contextLimit  Int      @default(32000)
  /// 模型能力声明（规范化 JSON 字符串数组）。
  /// 取值必须来自抽象能力白名单（如 TEXT_GENERATION / STRUCTURED_OUTPUT / VISION / LONG_CONTEXT / FILE_ANALYSIS），
  /// 严禁写入具体厂商或模型名；contextLimit 不得作为能力替代表达。
  capabilities  Json     @default("[]")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// 价格（唯一真源 modelpricing）；删除部署时级联删除，避免价格孤儿
  pricing       modelpricing?
  /// 时段价格覆盖（删除部署时级联删除）
  periods      modelpricingperiod[]
  /// 所属供应商（外键锁定 providerId → modelprovider.name，禁止悬挂引用）
  provider      modelprovider @relation(fields: [providerId], references: [name], onDelete: Restrict, onUpdate: Restrict, map: "ModelDeployment_providerId_fkey")
  /// 被空间模型策略引用为默认模型（RESTRICT：被引用时数据库层面禁止删除）
  defaultInPolicies workspace_model_policy[]

  @@unique([providerId, modelId], map: "ModelDeployment_providerId_modelId_key")
  @@index([providerId], map: "ModelDeployment_providerId_idx")
  @@index([enabled], map: "ModelDeployment_enabled_idx")
}

/// 模型价格（供应商成本与用户售价分开保存；单位：微元 / 100 万 Token，1 微元 = 1e-6 元）
/// 说明：不使用「整数分/1K」作为唯一单位，以支持低价模型（如 0.2 分/1K = 2 元/百万 = 2_000_000 微元）与元/百万小数。
model modelpricing {
  id          String   @id
  deploymentId String  @unique(map: "ModelPricing_deploymentId_key")
  currency    String   @default("CNY")

  /// 正式外键级联：删除模型部署时同事务级联删除对应价格，杜绝价格孤儿
  deployment  modeldeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade, map: "ModelPricing_deploymentId_fkey")

  /// —— 供应商成本（平台侧支出）——
  costInputMicrosPerMillion      Int?
  costOutputMicrosPerMillion     Int?
  costCacheReadMicrosPerMillion  Int?
  costCacheWriteMicrosPerMillion Int?

  /// —— 用户售价（对外扣点依据，与成本分离）——
  priceInputMicrosPerMillion      Int?
  priceOutputMicrosPerMillion     Int?
  priceCacheReadMicrosPerMillion  Int?
  priceCacheWriteMicrosPerMillion Int?

  /// 价格来源：UNVERIFIED 未验证 | OBSERVED_ONLY 仅观测数据 | VERIFIED 供应商价目表已确认
  priceSource String @default("UNVERIFIED")
  /// 价格状态：UNCONFIGURED 未配置 | FREE 明确免费 | OBSERVED_ONLY | VERIFIED
  priceStatus String @default("UNCONFIGURED")
  /// 价格来源（计费口径）：PLATFORM 平台模型注册表 | USER_BYOK 用户自带模型（按官方价折算后收服务费）
  priceOrigin String @default("PLATFORM")
  /// 平台加价率（基点，1bp = 0.01%）；非空时覆盖全局加价系数 k（按模型覆盖）
  markupRateBps Int?
  /// 价格版本（每次改价递增）
  priceVersion Int @default(1)
  /// 价格生效时间
  effectiveFrom DateTime?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 模型时段价格（在「主流价」modelpricing 之上叠加的时段覆盖价）
/// 生效规则（周计划 + 日期区间，二选一或叠加）：
///   - 周计划：weekdays（1=周一..7=周日，逗号分隔，null=每天）+ startTime/endTime（HH:mm，每天窗口）
///   - 日期区间：startDate/endDate（含当日，用于节日/自定义绝对区间）
/// 结算时按当前时钟+日期挑「enabled 且命中且 priority 最高」的时段价；无命中则回退主流价。
model modelpricingperiod {
  id          String  @id @default(uuid())
  deploymentId String
  deployment  modeldeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade, map: "ModelPricingPeriod_deploymentId_fkey")

  /// 时段名称（管理员自定义，如「闲时」「国庆」）
  name String
  /// 类型：IDLE 闲时 | PEAK 高峰 | HOLIDAY 节日 | CUSTOM 自定义（仅用于排序与展示）
  kind String @default("CUSTOM")
  /// 是否启用（禁用后结算忽略该时段）
  enabled Boolean @default(true)
  /// 优先级（数值大者优先；同级按 HOLIDAY>PEAK>IDLE>CUSTOM）
  priority Int @default(0)

  /// 周计划：星期几（1=周一..7=周日），逗号分隔；null=每天
  weekdays String?
  /// 每天起止时间 HH:mm（周计划窗口用，不支持跨天）
  startTime String?
  endTime   String?

  /// 日期区间（节日/自定义绝对区间用，含当日）
  startDate DateTime?
  endDate   DateTime?

  /// —— 供应商成本（平台侧支出）——
  costInputMicrosPerMillion      Int?
  costOutputMicrosPerMillion     Int?
  costCacheReadMicrosPerMillion  Int?
  costCacheWriteMicrosPerMillion Int?

  /// —— 用户售价（对外扣点依据）——
  priceInputMicrosPerMillion      Int?
  priceOutputMicrosPerMillion     Int?
  priceCacheReadMicrosPerMillion  Int?
  priceCacheWriteMicrosPerMillion Int?

  priceSource String @default("UNVERIFIED")
  priceStatus String @default("UNCONFIGURED")
  markupRateBps Int?
  priceVersion Int @default(1)
  /// 快照展示用：取 startDate
  effectiveFrom DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deploymentId])
}

/// 模型成本观测数据（如「综合有效成本」），**仅用于成本分析与运营报表，不得作为输入/输出官方单价**
model modelcostobservation {
  id                              String   @id
  providerId                      String
  modelId                         String
  /// 观测口径：OBSERVED_BLENDED_COST
  metric                          String   @default("OBSERVED_BLENDED_COST")
  currency                        String   @default("USD")
  totalTokens                     Int
  inputTokens                     Int
  outputTokens                    Int
  cacheTokens                     Int
  nonCacheTokens                  Int
  requestCount                    Int
  /// 总费用（微美元，1 微美元 = 1e-6 美元）
  totalCostMicrosUsd              Int
  /// 综合有效成本（微美元 / 100 万 Token，含缓存）
  effectiveCostPerMillionMicrosUsd Int
  /// 不含缓存的综合成本（微美元 / 100 万 Token）
  nonCacheCostPerMillionMicrosUsd  Int
  note                            String?  @db.Text
  createdAt                       DateTime @default(now())

  @@index([providerId, modelId], map: "ModelCostObservation_provider_model_idx")
}

/// 空间模型策略：默认模型与允许模型白名单
model workspace_model_policy {
  id          String   @id
  workspaceId String   @unique(map: "WorkspaceModelPolicy_workspaceId_key")
  /// 默认模型部署 ID（外键 RESTRICT：被引用时数据库层面禁止删除该部署）
  defaultDeploymentId   String?
  /// 允许的部署 ID 列表（JSON 数组；非空时启用白名单限制）
  /// 注意：JSON 无法建立数据库外键，其引用完整性由 model-registry-lock 的命名锁 + 接口校验共同保证
  allowedDeploymentIds  Json     @default("[]")
  defaultDeployment     modeldeployment? @relation(fields: [defaultDeploymentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "WorkspaceModelPolicy_defaultDeploymentId_fkey")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 空间自带模型（BYO：Bring Your Own Model）
/// 由空间所有者/管理员配置，覆盖该空间的默认执行模型；平台仍按此处配置的价格向用户收费。
/// API Key 以 AES-256-GCM 密文落库（apiKeyCipher），明文密钥绝不写入数据库。
/// 一个空间至多一条有效 BYO 配置（workspaceId 唯一）。
model workspace_byo_model {
  id            String   @id @default(uuid())
  workspaceId   String   @unique(map: "WorkspaceByoModel_workspaceId_key")
  /// 展示名（同时作为调用时下发的 upstreamModel）
  label         String
  /// 对接协议：本期仅 OPENAI_COMPATIBLE
  protocol      String   @default("OPENAI_COMPATIBLE")
  /// 服务端直连地址
  baseUrl       String
  /// API Key 密文（AES-256-GCM base64）
  apiKeyCipher  String
  /// 模型能力声明（规范化 JSON 字符串数组，取值须来自抽象能力白名单）
  capabilities  Json     @default("[]")
  /// 上下文上限（tokens）
  contextLimit  Int      @default(32000)
  /// 是否启用（禁用则回落到空间/平台默认模型）
  enabled       Boolean  @default(true)
  /// —— 厂商官方单价（微元 / 100 万 Token）——【商业化方案 B】
  /// BYO 下平台不承担厂商成本，此处登记的是「厂商官方单价」，不是平台售价。
  /// 对外扣点 = 官方单价折算点数 ×（1 + 服务费费率 billing.byokServiceRateBps，默认 15%）。
  /// 未登记（NULL）时算账中心（src/lib/billing/pricing-center.ts）一律阻断估价，绝不猜测默认价。
  priceInputMicrosPerMillion   Int?
  priceOutputMicrosPerMillion  Int?
  priceStatus   String   @default("UNCONFIGURED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId], map: "WorkspaceByoModel_workspaceId_idx")
}
/// 模型注册表「引用完整性」串行锁（单行单例）。
/// 通过 SELECT ... FOR UPDATE 获取：InnoDB 行锁由数据库持有至事务 COMMIT/ROLLBACK 自动释放，
/// 因此保护边界必然覆盖到「提交完成」，不存在「提交前提前释放锁」的窗口
/// （这是相对 MySQL 命名锁 GET_LOCK/RELEASE_LOCK 的关键区别：后者需手工释放，无法与 COMMIT 对齐）。
model registrylock {
  id        String   @id
  createdAt DateTime @default(now())
}

model tokenrechargeorder {
  id            String    @id
  orderNo       String    @unique(map: "TokenRechargeOrder_orderNo_key")
  workspaceId   String
  workspaceName String?
  /// 入账范围：WALLET 个人钱包 | WORKSPACE 企业空间共享池
  scope         String
  applicantId   String
  applicantName String?
  packId        String?
  packName      String?
  points        BigInt
  /// 应付金额（单位：分）
  amountCents   Int       @default(0)
  /// OFFLINE_BANK 对公转账 | CONTRACT 合同结算
  paymentMethod String    @default("OFFLINE_BANK")
  /// 发票信息
  invoiceTitle  String?
  taxNo         String?
  bankName      String?
  bankAccount   String?
  /// 付款凭证（截图/回单链接或 base64 标识）
  voucherUrl    String?
  remark        String?   @db.Text
  /// PENDING 待审批 | APPROVED 审批通过待收款 | PAID 已收款已入账
  /// REJECTED 已驳回 | CANCELLED 已撤销
  status        String    @default("PENDING")
  reviewerId    String?
  reviewerName  String?
  reviewNote    String?   @db.Text
  reviewedAt    DateTime?
  paidAt        DateTime?
  /// 入账后生成的流水号
  ledgerId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, status], map: "TokenRechargeOrder_workspaceId_status_idx")
  @@index([applicantId], map: "TokenRechargeOrder_applicantId_idx")
  @@index([status, createdAt], map: "TokenRechargeOrder_status_createdAt_idx")
}

// ============================================================
// 资料治理模块：移除单 / 资料级权限 / 版本 / 评论 / 分享
// 说明：以下表仅以 String 保存关联 ID，不建立 Prisma 关系，
// 避免改动既有 model，且移除记录需长期留存、不随资料级联删除。
// ============================================================

// 资料移除单：管理员移除资料的原因与执行记录，支持恢复
model documentremoval {
  id            String    @id
  documentId    String
  workspaceId   String
  titleSnapshot String
  uploaderId    String?
  removedBy     String
  reasonCode    String // VIOLATION 违规 | EXPIRED 过期 | COPYRIGHT 版权 | OTHER 其他
  reasonDetail  String?   @db.Text
  // 删除申请状态：PENDING 待管理员审核（普通成员删除自己资料）| APPROVED 已生效移除 | REJECTED 已驳回
  status        String   @default("APPROVED")
  // 管理员驳回删除申请时填写的意见，回写给申请人
  rejectReason  String?   @db.Text
  notifiedCount Int       @default(0)
  removedAt     DateTime  @default(now())
  restoredAt    DateTime?
  restoredBy    String?
  // 上传人确认接收移除：确认后资料转入个人私密，可在治理中心申请恢复
  confirmedAt   DateTime?
  confirmedBy   String?
  // 上传人申请恢复：记录申请时间与说明，避免重复申请并更新遮罩层状态
  restoreRequestedAt    DateTime?
  restoreRequestMessage String?   @db.Text

  @@index([workspaceId, removedAt], map: "DocumentRemoval_workspaceId_removedAt_idx")
  @@index([documentId], map: "DocumentRemoval_documentId_idx")
  @@index([workspaceId, status], map: "DocumentRemoval_workspaceId_status_idx")
  @@index([workspaceId, confirmedAt], map: "DocumentRemoval_workspaceId_confirmedAt_idx")
}

// 资料级操作权限：可精确授予某成员，或按角色 / 岗位批量授予
model assetpermission {
  id               String   @id
  workspaceId      String
  userId           String?
  roleScope        String?
  positionCode     String?
  canView          Boolean  @default(true)
  canUpload        Boolean  @default(false)
  canEdit          Boolean  @default(false)
  canDelete        Boolean  @default(false)
  canShare         Boolean  @default(false)
  canComment       Boolean  @default(true)
  canManageVersion Boolean  @default(false)
  grantedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId], map: "AssetPermission_workspaceId_idx")
  @@index([workspaceId, userId], map: "AssetPermission_workspaceId_userId_idx")
}

// 资料版本快照：编辑前自动留存，支持对比与回滚
model documentversion {
  id         String   @id
  documentId String
  versionNo  Int
  title      String
  content    String   @db.Text
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@unique([documentId, versionNo], map: "DocumentVersion_documentId_versionNo_key")
  @@index([documentId, createdAt], map: "DocumentVersion_documentId_createdAt_idx")
}

// 空间级套餐配置表：供空间创建初始化与空间套餐升级使用，后台可配置
model workspaceplan {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String
  priceMonthly  Int      @default(0)
  priceYearly   Int      @default(0)
  maxComponents Int      @default(0)
  maxMembers    Int      @default(0)
  maxStorage    Int      @default(0)
  maxApiCalls   Int      @default(0)
  tokenLimit    Int      @default(0)
  features      Json?
  sortOrder     Int      @default(0)
  purchasable   Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder], map: "WorkspacePlan_sortOrder_idx")
  @@index([isActive], map: "WorkspacePlan_isActive_idx")
}

// 资料评论：支持楼中楼回复
model documentcomment {
  id          String   @id
  documentId  String
  workspaceId String
  userId      String
  userName    String?
  content     String   @db.Text
  parentId    String?
  createdAt   DateTime @default(now())

  @@index([documentId, createdAt], map: "DocumentComment_documentId_createdAt_idx")
  @@index([workspaceId], map: "DocumentComment_workspaceId_idx")
}

// 资料分享链接：token 访问，支持过期与吊销
model documentshare {
  id          String    @id
  documentId  String
  workspaceId String
  token       String    @unique
  permission  String    @default("view") // view | download
  expiresAt   DateTime?
  accessCount Int       @default(0)
  revokedAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([documentId], map: "DocumentShare_documentId_idx")
  @@index([workspaceId], map: "DocumentShare_workspaceId_idx")
}

// 通知受众群组：支撑系统通知的「按角色推送」与「自定义人群推送」
// type=system：系统角色群组，roleKey 对应 user.role 的值，基础人群由 role 动态算出（不再硬编码）
// type=custom：自定义群组，人群完全来自 notificationgroupmember 的 include 名单
model notificationgroup {
  id          String                     @id @default(cuid())
  name        String
  type        String                     @default("custom") // system | custom
  roleKey     String? // 仅系统群组使用：对应的 user.role 枚举值
  description String?
  createdBy   String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  members     notificationgroupmember[]

  @@index([type], map: "NotificationGroup_type_idx")
  @@index([roleKey], map: "NotificationGroup_roleKey_idx")
}

// 群组成员增删名单：exclude=从群组基础人群中剔除，include=额外追加进群组
// 最终推送人群 = (系统群组基础人群 − exclude) ∪ include
model notificationgroupmember {
  id        String             @id @default(cuid())
  groupId   String
  userId    String
  action    String             @default("include") // include | exclude
  createdAt DateTime           @default(now())
  group     notificationgroup  @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "NotificationGroupMember_groupId_fkey")

  @@unique([groupId, userId], map: "NotificationGroupMember_groupId_userId_key")
  @@index([groupId], map: "NotificationGroupMember_groupId_idx")
  @@index([userId], map: "NotificationGroupMember_userId_idx")
}

// Phase 2A: 真实 Token 结算预扣记录表
model tokensettlementhold {
  id                          String          @id
  taskId                      String          @unique(map: "TokenSettlementHold_taskId_key")
  userId                      String
  workspaceId                 String
  holdPoints                  BigInt
  monthlyTokenUsedIncremented BigInt          @default(0)
  status                      String          @default("HELD") // HELD | SETTLED | RELEASED | REQUIRES_REVIEW
  idempotencyKey              String          @unique(map: "TokenSettlementHold_idempotencyKey_key")
  holdDetails                 Json            // 预扣分桶明细（用于原路释放与差额对齐）
  expiresAt                   DateTime
  statusChangedAt             DateTime        @default(now())
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  tokensettlement             tokensettlement?

  @@index([userId, status], map: "TokenSettlementHold_userId_status_idx")
  @@index([workspaceId, status], map: "TokenSettlementHold_workspaceId_status_idx")
  @@index([status, expiresAt], map: "TokenSettlementHold_status_expiresAt_idx")
}

// Phase 2A: 真实 Token 结算流水与审计表
model tokensettlement {
  id                          String              @id
  taskId                      String              @unique(map: "TokenSettlement_taskId_key")
  userId                      String
  workspaceId                 String
  status                      String              @default("HOLD") // HOLD | SETTLED | RELEASED | REQUIRES_REVIEW
  holdPoints                  BigInt
  monthlyTokenUsedIncremented BigInt              @default(0)
  actualPricePoints           BigInt              @default(0)
  releasedPoints              BigInt              @default(0)
  supplementPoints            BigInt              @default(0)
  inputTokens                 BigInt              @default(0)
  outputTokens                BigInt              @default(0)
  cacheReadTokens             BigInt              @default(0)
  cacheWriteTokens            BigInt              @default(0)
  costMicros                  BigInt?
  userPriceMicros             BigInt?
  pricingSnapshot             Json                // 任务发生时绑定的价格快照（历史不可变）
  settlementVersion           Int                 @default(1)
  errorCode                   String?
  auditMessage                String?             @db.Text
  settledAt                   DateTime?
  releasedAt                  DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  tokensettlementhold         tokensettlementhold @relation(fields: [taskId], references: [taskId], onDelete: Cascade, map: "TokenSettlement_taskId_fkey")

  @@index([userId, createdAt], map: "TokenSettlement_userId_createdAt_idx")
  @@index([workspaceId, createdAt], map: "TokenSettlement_workspaceId_createdAt_idx")
  @@index([status], map: "TokenSettlement_status_idx")
}

// Phase 2A: 真实 Token 结算异常与超时恢复记录表
model tokensettlementrecovery {
  id                  String    @id
  taskId              String    @unique(map: "TokenSettlementRecovery_taskId_key")
  userId              String
  workspaceId         String
  status              String    @default("PENDING") // PENDING | PROCESSING | SETTLED | RELEASED | REQUIRES_REVIEW
  recoveryType        String    // SETTLEMENT_FAILED | RELEASE_FAILED | EXPIRED_HOLD_REAP | TASK_WRITE_FAILED
  retryCount          Int       @default(0)
  lastError           String?   @db.Text
  usage               Json?
  pricingSnapshot     Json?
  settlementVersion   Int?
  processingStartedAt DateTime?
  leaseUntil          DateTime?
  claimToken          String?   @unique(map: "TokenSettlementRecovery_claimToken_key")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, leaseUntil], map: "TokenSettlementRecovery_status_leaseUntil_idx")
  @@index([userId], map: "TokenSettlementRecovery_userId_idx")
}

