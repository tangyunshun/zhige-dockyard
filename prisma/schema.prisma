  value     String?  @db.MediumText
  updatedAt DateTime @updatedAt
  @@map("system_config")
}

// ============ 组件目录（唯一数据源，禁止前端/后端代码写死组件信息） ============

// 组件目录表：系统全部组件的元数据（名称/描述/分类/图标/标签/计费/预览/输入方式）。
// 前端与后端一律通过 /api/studio?action=catalog 从本表读取，代码中不得再硬编码组件列表。
model componentcatalog {
  id              String    @id // C01-C53
  name            String
  description     String
  category        String // 分类 key（BID_PREP / REQ_DESIGN / ...）
  icon            String
  tags            Json // string[]
  isPremium       Boolean   @default(false)
  /// 预估模型 Token 消耗（AI 实际 token 数）：属「用量度量单位」，不是算力点、更不是计费货币。
  /// 严禁把该值直接当作应扣算力点；所有扣点必须经算账中心 src/lib/billing/pricing-center.ts 换算。
  estimatedModelTokens Int       @default(0) @map("estimatedTokens")
  previewData     Json // { inputMock, outputMock, roiText }
  businessTags    Json? // string[]
  inputMode       String    @default("text") // text | file | both
  accept          String? // 文件上传支持的格式
  hint            String? // 界面引导文案
  detail          Json? // 深度详情：{ fullDescription, usage, apiDoc, faq }
  isDefault       Boolean   @default(false) // 是否为新空间默认装配的 5 套件组件
  contract        String? // 数据流动契约描述，如 "PDF ➜ 偏离表"
  keywords        Json? // 智能搜索关键词 string[]，用于需求检索匹配组件
  sortOrder       Int       @default(0)
  isPublished     Boolean   @default(true)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  activeContractId String?  @map("active_contract_id")
  activeContract   componentcontract? @relation("ActiveContractForCatalog", fields: [activeContractId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ComponentCatalog_activeContractId_fkey")
  contracts       componentcontract[] @relation("ComponentToContracts")

  @@index([activeContractId], map: "ComponentCatalog_activeContractId_idx")
  @@index([category], map: "ComponentCatalog_category_idx")
  @@index([isPublished], map: "ComponentCatalog_isPublished_idx")
  @@index([sortOrder], map: "ComponentCatalog_sortOrder_idx")
  @@map("component_catalog")
}

// 通用组件合同版本表（不可变版本行）
model componentcontract {
  id              String    @id @default(cuid())
  componentId     String    @map("component_id")
  contractVersion String    @map("contract_version") // 语义化版本号，如 "1.0.0", "1.1.0"
  lifecycle       String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  description     String?   @db.Text
  contract        Json      // 完整经过 validateComponentContract 校验的 ComponentContract JSON
  publishedAt     DateTime? @map("published_at")
  publishedBy     String?   @map("published_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  component       componentcatalog @relation("ComponentToContracts", fields: [componentId], references: [id], onDelete: Restrict, map: "ComponentContract_componentId_fkey")
  activeForCatalogs componentcatalog[] @relation("ActiveContractForCatalog")

  @@unique([componentId, contractVersion], map: "ComponentContract_componentId_contractVersion_key")
  @@index([componentId, lifecycle], map: "ComponentContract_componentId_lifecycle_idx")
  @@map("component_contract")
}

// 组件分类表：阶段分类的显示名/主题色/组件范围。
model componentcategory {
  key       String   @id // BID_PREP / REQ_DESIGN / ...
  name      String
  color     String
  range     String // 如 "C01-C06"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true) // 启用/停用状态：启用的阶段不可编辑/删除，仅可禁用
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive], map: "ComponentCategory_isActive_idx")
  @@map("component_category")
}

// 岗位表：预置岗位 + 空间所有者自定义岗位统一定义（名称/徽标/默认组件授权矩阵）。
// 预置岗位由 seed 一次性写入（isPreset=true），运行期由 /api/studio?action=positions 与配置中心读写。
model position {
  id                         String   @id // 如 pos_owner / pos_custom_xxx
  code                       String   @unique // 如 OWNER / PROJECT_MANAGER / 自定义唯一码
  name                       String
  badge                      String?
  icon                       String?
  colorCls                   String? // Tailwind 徽章样式类
  description                String?
  isPreset                   Boolean  @default(true) // 预置岗位不可删除，仅可覆盖授权
  editable                   Boolean  @default(true) // 是否允许空间所有者编辑
  status                     String   @default("ACTIVE") // ACTIVE | DISABLED
  defaultAllowedComponentIds Json? // string[] 默认允许组件 ID，null 表示不限制
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([status], map: "Position_status_idx")
  @@index([sortOrder], map: "Position_sortOrder_idx")
  @@map("position")
}

// Webhook 事件订阅实体表：支持 Webhooks 真实订阅与事件推发日志
model webhooksubscription {
  id             String    @id @default(uuid())
  userId         String
  url            String
  secret         String
  events         Json      // string[] 存订阅事件
  active         Boolean   @default(true)
  successRate    String    @default("100%")
  lastTriggered  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId], map: "Webhook_userId_idx")
  @@index([active], map: "Webhook_active_idx")
  @@map("webhooksubscription")
}

// 账单与交易记录表：记录空间套餐升级、会员订阅、算力充值等真实交易流水，
// 供计费中心查询、对账与发票导出使用（对应前端 /settings/billing 页面）。
model billingrecord {
  id          String   @id
  userId      String
  workspaceId String?
  // 交易类型：PLAN_UPGRADE 空间套餐升级 / MEMBERSHIP 会员订阅 / TOKEN_RECHARGE 算力充值 / REFUND 退款
  type        String
  title       String // 交易描述说明
  // 交易金额，单位：分（与 membershiplevel 价格口径保持一致）
  amount      Int      @default(0)
  currency    String   @default("CNY")
  // 交易状态：SUCCESS 成功 / PENDING 处理中 / FAILED 失败 / REFUNDED 已退款
  status      String   @default("SUCCESS")
  channel     String? // 支付渠道
  referenceId String? // 关联业务单号（如操作日志 ID）
  invoiceUrl  String?
  metadata    Json? // 扩展信息（如套餐升级前后对比）

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId], map: "BillingRecord_userId_idx")
  @@index([workspaceId], map: "BillingRecord_workspaceId_idx")
  @@index([status], map: "BillingRecord_status_idx")
  @@index([createdAt], map: "BillingRecord_createdAt_idx")
  @@map("billing_record")
}

// 系统动态配置（key-value，JSON 文本）：供管理员在后台调整而无需发版
// 例如 key = "ai_pricing_config" 存放 AI 厂商价格表与加价系数。
