  value     String?
  updatedAt DateTime @updatedAt
  @@map("system_config")
}

// ============ 组件目录（唯一数据源，禁止前端/后端代码写死组件信息） ============

// 组件目录表：系统全部组件的元数据（名称/描述/分类/图标/标签/计费/预览/输入方式）。
// 前端与后端一律通过 /api/studio?action=catalog 从本表读取，代码中不得再硬编码组件列表。
model componentcatalog {
  id              String    @id // C01-C53
  name            String
  description     String
  category        String // 分类 key（BID_PREP / REQ_DESIGN / ...）
  icon            String
  tags            Json // string[]
  isPremium       Boolean   @default(false)
  estimatedTokens Int       @default(0)
  previewData     Json // { inputMock, outputMock, roiText }
  businessTags    Json? // string[]
  inputMode       String    @default("text") // text | file | both
  accept          String? // 文件上传支持的格式
  hint            String? // 界面引导文案
  detail          Json? // 深度详情：{ fullDescription, usage, apiDoc, faq }
  isDefault       Boolean   @default(false) // 是否为新空间默认装配的 5 套件组件
  contract        String? // 数据流动契约描述，如 "PDF ➜ 偏离表"
  keywords        Json? // 智能搜索关键词 string[]，用于需求检索匹配组件
  sortOrder       Int       @default(0)
  isPublished     Boolean   @default(true)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category], map: "ComponentCatalog_category_idx")
  @@index([isPublished], map: "ComponentCatalog_isPublished_idx")
  @@index([sortOrder], map: "ComponentCatalog_sortOrder_idx")
  @@map("component_catalog")
}

// 组件分类表：阶段分类的显示名/主题色/组件范围。
model componentcategory {
  key       String   @id // BID_PREP / REQ_DESIGN / ...
  name      String
  color     String
  range     String // 如 "C01-C06"
  sortOrder Int      @default(0)

  @@map("component_category")
}

// 岗位表：预置岗位 + 空间所有者自定义岗位统一定义（名称/徽标/默认组件授权矩阵）。
// 预置岗位由 seed 一次性写入（isPreset=true），运行期由 /api/studio?action=positions 与配置中心读写。
model position {
  id                         String   @id // 如 pos_owner / pos_custom_xxx
  code                       String   @unique // 如 OWNER / PROJECT_MANAGER / 自定义唯一码
  name                       String
  badge                      String?
  icon                       String?
  colorCls                   String? // Tailwind 徽章样式类
  description                String?
  isPreset                   Boolean  @default(true) // 预置岗位不可删除，仅可覆盖授权
  editable                   Boolean  @default(true) // 是否允许空间所有者编辑
  status                     String   @default("ACTIVE") // ACTIVE | DISABLED
  defaultAllowedComponentIds Json? // string[] 默认允许组件 ID，null 表示不限制
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([status], map: "Position_status_idx")
  @@index([sortOrder], map: "Position_sortOrder_idx")
  @@map("position")
}

// Webhook 事件订阅实体表：支持 Webhooks 真实订阅与事件推发日志
model webhooksubscription {
  id             String    @id @default(uuid())
  userId         String
  url            String
  secret         String
  events         Json      // string[] 存订阅事件
  active         Boolean   @default(true)
  successRate    String    @default("100%")
  lastTriggered  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId], map: "Webhook_userId_idx")
  @@index([active], map: "Webhook_active_idx")
  @@map("webhooksubscription")
}

// 账单与交易记录表：记录空间套餐升级、会员订阅、算力充值等真实交易流水，
// 供计费中心查询、对账与发票导出使用（对应前端 /settings/billing 页面）。
model billingrecord {
  id          String   @id
  userId      String
  workspaceId String?
  // 交易类型：PLAN_UPGRADE 空间套餐升级 / MEMBERSHIP 会员订阅 / TOKEN_RECHARGE 算力充值 / REFUND 退款
  type        String
  title       String // 交易描述说明
  // 交易金额，单位：分（与 membershiplevel 价格口径保持一致）
  amount      Int      @default(0)
  currency    String   @default("CNY")
  // 交易状态：SUCCESS 成功 / PENDING 处理中 / FAILED 失败 / REFUNDED 已退款
  status      String   @default("SUCCESS")
  channel     String? // 支付渠道
  referenceId String? // 关联业务单号（如操作日志 ID）
  invoiceUrl  String?
  metadata    Json? // 扩展信息（如套餐升级前后对比）

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId], map: "BillingRecord_userId_idx")
  @@index([workspaceId], map: "BillingRecord_workspaceId_idx")
  @@index([status], map: "BillingRecord_status_idx")
  @@index([createdAt], map: "BillingRecord_createdAt_idx")
  @@map("billing_record")
}

model tokenpack {
  id          String   @id
  name        String
  points      BigInt
  price       Float
  icon        String?  @default("⚡")
  color       String?  @default("#3182ce")
  description String?
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive], map: "TokenPack_isActive_idx")
  @@index([sortOrder], map: "TokenPack_sortOrder_idx")
}

/// 用户算力钱包：跨空间通用的算力点余额（快照，真源为 pointgrant 分桶剩余量之和）
/// 说明：钱包中的算力点可在个人空间与企业空间中通用消费。
model userwallet {
  id        String   @id
  userId    String   @unique(map: "UserWallet_userId_key")
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], map: "UserWallet_userId_idx")
}

/// 算力分桶（发放批次）：每一笔发放（赠送 / 在线充值 / 线下工单入账 / 退款 / 后台调整）
/// 生成一个独立分桶，记录发放量、剩余量与到期时间。
/// 消耗时按「最早到期优先」逐桶扣减；到期未用完的桶由到期清算任务清零。
model pointgrant {
  id          String    @id
  /// 归属范围：WALLET 用户钱包（跨空间通用）| WORKSPACE 空间共享池 | PERSONAL_GIFT 个人空间专属赠送
  scope       String
  userId      String?
  workspaceId String?
  /// 本桶发放总量
  points      BigInt
  /// 本桶剩余可用量
  remaining   BigInt
  /// 来源类型：GIFT_REGISTER / RECHARGE / OFFLINE_ORDER / MEMBERSHIP / REFUND / MANUAL
  sourceType  String
  /// 关联单号（充值订单号 / 工单号 / 流水号）
  sourceId    String?
  /// 到期时间，null 表示永不过期（赠送点默认 3 个月有效）
  expiresAt   DateTime?
  /// ACTIVE 可用 | EXPIRED 已到期清零 | EXHAUSTED 已用完
  status      String    @default("ACTIVE")
  /// 发放人（后台人工入账/审批人）
  operatorId  String?
  title       String?
  remark      String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status], map: "PointGrant_userId_status_idx")
  @@index([workspaceId, status], map: "PointGrant_workspaceId_status_idx")
  @@index([status, expiresAt], map: "PointGrant_status_expiresAt_idx")
}

/// 算力点流水总账：所有入账与出账的唯一权威记录，用于明细呈现、统计与对账
model pointledger {
  id            String   @id
  /// 方向：IN 入账 | OUT 出账
  direction     String
  /// 类型：GIFT_REGISTER 新用户赠送 | GIFT_EXPIRE 赠送到期清零 | RECHARGE 在线充值
  ///      OFFLINE_RECHARGE 线下工单入账 | MEMBERSHIP_GRANT 会员额度 | CONSUME 组件消耗
  ///      REFUND 退回 | MANUAL_ADJUST 后台人工调整
  type          String
  /// 归属范围：WALLET | WORKSPACE | PERSONAL_GIFT
  scope         String
  userId        String?
  userEmail     String?
  workspaceId   String?
  workspaceName String?
  /// 空间类型：PERSONAL | ENTERPRISE（便于个人/企业消耗分账统计）
  workspaceType String?
  /// 操作人（消费者 / 后台操作人 / 审批人）
  operatorId    String?
  /// 变动点数（正数，增减由 direction 决定）
  points        BigInt
  /// 变动后该账户余额快照（用于对账）
  balanceAfter  BigInt   @default(0)
  /// 实付金额（单位：分），赠送/消耗为 0
  amountCents   Int      @default(0)
  /// 支付方式：WECHAT_PAY | ALIPAY | OFFLINE_BANK | CONTRACT | SYSTEM | MANUAL
  paymentMethod String?
  /// 关联订单号 / 工单号
  orderNo       String?
  /// 关联分桶 ID
  grantId       String?
  componentId   String?
  componentName String?
  taskId        String?
  title         String
  remark        String?  @db.Text
  /// 幂等键（赠送、扣费、入账均需携带，防止重复记账）
  idempotencyKey String? @unique(map: "PointLedger_idempotencyKey_key")
  createdAt     DateTime @default(now())

  @@index([userId, createdAt], map: "PointLedger_userId_createdAt_idx")
  @@index([workspaceId, createdAt], map: "PointLedger_workspaceId_createdAt_idx")
  @@index([type], map: "PointLedger_type_idx")
  @@index([direction], map: "PointLedger_direction_idx")
  @@index([createdAt], map: "PointLedger_createdAt_idx")
}

/// 线下充值工单（对公转账 / 合同结算），审批通过后确认收款再自动入账，形成闭环
model tokenrechargeorder {
  id            String    @id
  orderNo       String    @unique(map: "TokenRechargeOrder_orderNo_key")
  workspaceId   String
  workspaceName String?
  /// 入账范围：WALLET 个人钱包 | WORKSPACE 企业空间共享池
  scope         String
  applicantId   String
  applicantName String?
  packId        String?
  packName      String?
  points        BigInt
  /// 应付金额（单位：分）
  amountCents   Int       @default(0)
  /// OFFLINE_BANK 对公转账 | CONTRACT 合同结算
  paymentMethod String    @default("OFFLINE_BANK")
  /// 发票信息
  invoiceTitle  String?
  taxNo         String?
  bankName      String?
  bankAccount   String?
  /// 付款凭证（截图/回单链接或 base64 标识）
  voucherUrl    String?
  remark        String?   @db.Text
  /// PENDING 待审批 | APPROVED 审批通过待收款 | PAID 已收款已入账
  /// REJECTED 已驳回 | CANCELLED 已撤销
  status        String    @default("PENDING")
  reviewerId    String?
  reviewerName  String?
  reviewNote    String?   @db.Text
  reviewedAt    DateTime?
  paidAt        DateTime?
  /// 入账后生成的流水号
  ledgerId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, status], map: "TokenRechargeOrder_workspaceId_status_idx")
  @@index([applicantId], map: "TokenRechargeOrder_applicantId_idx")
  @@index([status, createdAt], map: "TokenRechargeOrder_status_createdAt_idx")
}

// ============================================================
// 资料治理模块：移除单 / 资料级权限 / 版本 / 评论 / 分享
// 说明：以下表仅以 String 保存关联 ID，不建立 Prisma 关系，
// 避免改动既有 model，且移除记录需长期留存、不随资料级联删除。
// ============================================================

// 资料移除单：管理员移除资料的原因与执行记录，支持恢复
model documentremoval {
  id            String    @id
  documentId    String
  workspaceId   String
  titleSnapshot String
  uploaderId    String?
  removedBy     String
  reasonCode    String // VIOLATION 违规 | EXPIRED 过期 | COPYRIGHT 版权 | OTHER 其他
  reasonDetail  String?   @db.Text
  // 删除申请状态：PENDING 待管理员审核（普通成员删除自己资料）| APPROVED 已生效移除 | REJECTED 已驳回
  status        String   @default("APPROVED")
  // 管理员驳回删除申请时填写的意见，回写给申请人
  rejectReason  String?   @db.Text
  notifiedCount Int       @default(0)
  removedAt     DateTime  @default(now())
  restoredAt    DateTime?
  restoredBy    String?
  // 上传人确认接收移除：确认后资料转入个人私密，可在治理中心申请恢复
  confirmedAt   DateTime?
  confirmedBy   String?
  // 上传人申请恢复：记录申请时间与说明，避免重复申请并更新遮罩层状态
  restoreRequestedAt    DateTime?
  restoreRequestMessage String?   @db.Text

  @@index([workspaceId, removedAt], map: "DocumentRemoval_workspaceId_removedAt_idx")
  @@index([documentId], map: "DocumentRemoval_documentId_idx")
  @@index([workspaceId, status], map: "DocumentRemoval_workspaceId_status_idx")
  @@index([workspaceId, confirmedAt], map: "DocumentRemoval_workspaceId_confirmedAt_idx")
}

// 资料级操作权限：可精确授予某成员，或按角色 / 岗位批量授予
model assetpermission {
  id               String   @id
  workspaceId      String
  userId           String?
  roleScope        String?
  positionCode     String?
  canView          Boolean  @default(true)
  canUpload        Boolean  @default(false)
  canEdit          Boolean  @default(false)
  canDelete        Boolean  @default(false)
  canShare         Boolean  @default(false)
  canComment       Boolean  @default(true)
  canManageVersion Boolean  @default(false)
  grantedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId], map: "AssetPermission_workspaceId_idx")
  @@index([workspaceId, userId], map: "AssetPermission_workspaceId_userId_idx")
}

// 资料版本快照：编辑前自动留存，支持对比与回滚
model documentversion {
  id         String   @id
  documentId String
  versionNo  Int
  title      String
  content    String   @db.Text
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@unique([documentId, versionNo], map: "DocumentVersion_documentId_versionNo_key")
  @@index([documentId, createdAt], map: "DocumentVersion_documentId_createdAt_idx")
}

// 空间级套餐配置表：供空间创建初始化与空间套餐升级使用，后台可配置
model workspaceplan {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String
  priceMonthly  Int      @default(0)
  priceYearly   Int      @default(0)
  maxComponents Int      @default(0)
  maxMembers    Int      @default(0)
  maxStorage    Int      @default(0)
  maxApiCalls   Int      @default(0)
  tokenLimit    Int      @default(0)
  features      Json?
  sortOrder     Int      @default(0)
  purchasable   Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder], map: "WorkspacePlan_sortOrder_idx")
  @@index([isActive], map: "WorkspacePlan_isActive_idx")
}

// 资料评论：支持楼中楼回复
model documentcomment {
  id          String   @id
  documentId  String
  workspaceId String
  userId      String
  userName    String?
  content     String   @db.Text
  parentId    String?
  createdAt   DateTime @default(now())

  @@index([documentId, createdAt], map: "DocumentComment_documentId_createdAt_idx")
  @@index([workspaceId], map: "DocumentComment_workspaceId_idx")
}

// 资料分享链接：token 访问，支持过期与吊销
model documentshare {
  id          String    @id
  documentId  String
  workspaceId String
  token       String    @unique
  permission  String    @default("view") // view | download
  expiresAt   DateTime?
  accessCount Int       @default(0)
  revokedAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([documentId], map: "DocumentShare_documentId_idx")
  @@index([workspaceId], map: "DocumentShare_workspaceId_idx")
}
