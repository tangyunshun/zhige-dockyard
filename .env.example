# ==============================================================================
# 知阁·舟坊 (ZhiGe Dockyard) - 环境变量脱敏示例模板 (.env.example)
#
# ⚠️ 注意事项：
# 1. 请复制本文件为 .env 或 .env.local，并按部署环境填入真实的配置值；
# 2. 严禁在本模板文件中写入任何真实密码、Token 或密钥；
# 3. .env 和 .env.local 已被 .gitignore 严格忽略，切勿强制提交至版本库。
# ==============================================================================

# ------------------------------------------------------------------------------
# 数据库配置 (Database)
# ------------------------------------------------------------------------------
# MySQL 数据库连接 URL（格式：mysql://用户名:密码@主机:端口/数据库名?参数）
DATABASE_URL="mysql://username:password@localhost:3306/zhige_dockyard?charset=utf8mb4"

# ------------------------------------------------------------------------------
# 鉴权与安全 (Authentication & Security)
# ------------------------------------------------------------------------------
# 服务端 JWT 签名密钥（生产环境必须配置且长度至少 32 字符，严禁使用弱默认值）
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# AI 模型服务商接入 (Model Registry & Execution)
# ------------------------------------------------------------------------------
# 模型服务商 API Key（仅用于外部调度/执行环境，严禁写入代码或数据库）
MODEL_API_KEY=""

# 模型服务商 Base URL（OpenAI 兼容协议端点，末尾不带斜杠）
MODEL_BASE_URL="https://api.your-model-provider.com/v1"

# 模型服务商标识符（与数据库 modelprovider.name 一致，如 MagicAI）
MODEL_PROVIDER_ID="MagicAI"

# 默认模型代号（与数据库 modeldeployment.modelId 一致，如 gpt-5.5）
MODEL_ID="gpt-5.5"

# 模型调用超时限制（毫秒，默认 60000）
MODEL_TIMEOUT_MS=60000

# 模型单次请求最大输入字符数（默认 30000）
MODEL_MAX_INPUT_CHARS=30000

# 模型单次请求最大输出 Token 限制（默认 4096）
MODEL_MAX_OUTPUT_TOKENS=4096
