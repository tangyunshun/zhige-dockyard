# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build outputs
.next/
out/
build/
dist/

# Environment files (strictly ignored, never commit!)
.env
.env.*
!.env.example

# User uploads & binary assets
uploads/

# Debug and runtime logs
*.log
scratch/pilot-server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Turbopack & Cache
.turbo/
.system_generated/

# 本地工具 / IDE 数据（保留在本地，不入库）
.codebuddy/
*.tsbuildinfo

# 临时调试产物
*.err
*.out
nul

# OCR 训练数据（体积大，不入库）
*.traineddata

# 测试覆盖率产物
coverage/

# 其它前端框架 / 构建工具缓存（防止未来引入后误入库）
.cache/
.vite/
.parcel-cache/
.nuxt/
.output/

# 本地工具 / 代理数据目录（保留在本地，不入库）
.agents/

# 日志目录与进程 / 备份临时文件
logs/
*.pid
*.bak
*.tmp
*.temp
desktop.ini

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
